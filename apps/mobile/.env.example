# Web 应用（同时也是 API）的源。移动端所有请求都打到它的 /api/*。
# 真机调试必须填开发机的局域网 IP —— localhost 在设备上指向设备自身，不是你的电脑。
# 模拟器/仿真器上 http://localhost:3000 可用。
#
# 留空时：apps/mobile/package.json 的 dev/android/ios 脚本经 scripts/env.mjs 自动派生
# 自 monorepo 根 .env 的 OPENSTARTER_API_URL（与 web/cli/desktop/extension 同源）。此处的
# 本地 EXPO_PUBLIC_API_URL 优先级高于根值，故真机调试在此填写局域网 IP 即可覆盖。
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# ---------------------------------------------------------------------------
# 移动端分析供应商（构建期固化，不再由 web 管理端控制）
# ---------------------------------------------------------------------------
# App 是静态二进制：这些开关随构建打进安装包，管理端改不了已发布的包。
# 按渠道（EAS profile / 本地 .env）逐个填写即可；全部留空 = 不启用任何分析。
#
# GA4 (Firebase) 移动端开关：严格 "true" 才启用。
# 另需把 Firebase 配置文件放入 apps/mobile/（GoogleService-Info.plist /
# google-services.json，见 plugins/with-firebase-config.js）。
EXPO_PUBLIC_ANALYTICS_GA_ENABLED=false

# OpenPanel：clientId 与 clientSecret 两键都非空才启用（半配置视为未配置）。
# RN SDK 官方要求 clientSecret 进客户端（认证用），可在 OpenPanel 面板随时轮换。
EXPO_PUBLIC_ANALYTICS_OPENPANEL_CLIENT_ID=
EXPO_PUBLIC_ANALYTICS_OPENPANEL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# RevenueCat IAP（构建期开关 + 客户端 SDK key）
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_IAP_ENABLED 是构建期总开关（严格 "true" 才启用），与服务端
# revenuecat_enabled（web 管理端）及 RC SDK key 取 AND 才展示付费墙 ——
# 服务端开关保留远程 kill-switch 能力，webhook 门禁不变。
EXPO_PUBLIC_IAP_ENABLED=false

# iOS SDK key（形如 appl_xxx）。缺失时 IAP 整体降级为不可用（no-op）。
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
